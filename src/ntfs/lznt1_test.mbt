///|
/// 从真实 Windows 卷里取出的一个 LZNT1 压缩块（419 字节负载 + 2 字节头）。
///
/// 来源：由 tools/make_windows_image.ps1 生成的 NTFS 3.1 卷，`big.txt`
/// 的第一个压缩单元。用它当向量是因为**真实数据不会迁就实现者的误解**：
/// 早期版本的解码器把"长度 4 位 / 距离 12 位"写死，并且和本仓库里那个
/// 自制的 Python 编码器共享了同一个错误，合成镜像因此一直"通过"。

///|
/// `big.txt` 的一行，79 个字节。压缩块的输出应当是它的重复。
const FIXTURE_LINE : Bytes = b"moonfs compression fixture line - the quick brown fox jumps over the lazy dog\r\n"

///|
test "decode a chunk produced by windows" {
  let windows_chunk : Array[Int32] = [
    0xA2, 0xB1, 0x00, 0x6D, 0x6F, 0x6F, 0x6E, 0x66, 0x73, 0x20, 0x63, 0x00, 0x6F,
    0x6D, 0x70, 0x72, 0x65, 0x73, 0x73, 0x69, 0x00, 0x6F, 0x6E, 0x20, 0x66, 0x69,
    0x78, 0x74, 0x75, 0x00, 0x72, 0x65, 0x20, 0x6C, 0x69, 0x6E, 0x65, 0x20, 0x00,
    0x2D, 0x20, 0x74, 0x68, 0x65, 0x20, 0x71, 0x75, 0x00, 0x69, 0x63, 0x6B, 0x20,
    0x62, 0x72, 0x6F, 0x77, 0x01, 0x00, 0x78, 0x6F, 0x78, 0x20, 0x6A, 0x75, 0x6D,
    0x70, 0x40, 0x73, 0x20, 0x6F, 0x76, 0x65, 0x72, 0x02, 0x78, 0x6C, 0x00, 0x61,
    0x7A, 0x79, 0x20, 0x64, 0x6F, 0x67, 0x0D, 0xFE, 0x0A, 0xFF, 0x9D, 0x3F, 0x8A,
    0xFF, 0x9D, 0xBF, 0xB1, 0x7F, 0xC5, 0xC0, 0xCF, 0x7F, 0xC5, 0xFF, 0x3F, 0xD9,
    0xFF, 0xEC, 0x5F, 0x80, 0x21, 0x84, 0x5F, 0x80, 0x3F, 0x8A, 0x3F, 0x8A, 0x1F,
    0x94, 0xFF, 0x1F, 0x94, 0xFF, 0x9D, 0xFF, 0x9D, 0x3F, 0x3B, 0xDF, 0xA7, 0xDF,
    0xA7, 0xDF, 0x58, 0xBF, 0xB1, 0x3F, 0x9F, 0xBB, 0x9F, 0xBB, 0x9F, 0xBB, 0x7F,
    0xC5, 0x7F, 0xC5, 0x5F, 0xCF, 0x20, 0x66, 0xFF, 0x5F, 0xCF, 0x3F, 0xD9, 0x1F,
    0x94, 0x3F, 0xD9, 0x1F, 0xE3, 0x1F, 0xE3, 0xFF, 0xEC, 0xFF, 0xEC, 0xBF, 0xDF,
    0xF6, 0xDF, 0xF6, 0x6F, 0x7B, 0x7F, 0x27, 0x5F, 0x80, 0xAF, 0x18, 0x20, 0x2F,
    0x40, 0xFF, 0x4F, 0x85, 0x8F, 0x22, 0x0F, 0x4A, 0x4F, 0x85, 0xDF, 0x58, 0x3F,
    0x8A, 0x6F, 0x2C, 0x3F, 0x8A, 0xFF, 0x3F, 0x8A, 0x2F, 0x8F, 0x2F, 0x8F, 0x4F,
    0x36, 0x10, 0x91, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0xFF, 0xCF, 0x0E, 0xCF,
    0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF, 0x0E,
    0xFF, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0xEF, 0xA2, 0xEF, 0xA2, 0x7F, 0x27,
    0xFF, 0x4E, 0xEF, 0xA2, 0xFF, 0xDF, 0xA7, 0xDF, 0xA7, 0x5F, 0x31, 0xDF, 0x58,
    0xCF, 0xAC, 0x4F, 0x85, 0xCF, 0xAC, 0x3F, 0x3B, 0xFF, 0xBF, 0x62, 0xBF, 0xB1,
    0xBF, 0xB1, 0xBF, 0xB1, 0x1F, 0x45, 0x9F, 0x6C, 0x7F, 0x76, 0xFF, 0x4E, 0xFF,
    0x4F, 0x85, 0xFF, 0x4E, 0x7F, 0x76, 0x9F, 0xBB, 0xDF, 0x58, 0x9F, 0xBB, 0x90,
    0x20, 0xCF, 0x0E, 0xFF, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF,
    0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0xFF, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF,
    0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0x60, 0x2F, 0xCF, 0x0E, 0xCF, 0x0E, 0xFF, 0xCF,
    0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF, 0x0E,
    0xCF, 0x0E, 0xFF, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0x2F, 0xDE,
    0x5F, 0x80, 0x1F, 0xE3, 0x1F, 0xE3, 0xFF, 0x1F, 0xE3, 0x1F, 0xE3, 0x3F, 0x8A,
    0x0F, 0xE8, 0x0F, 0xE8, 0xBF, 0xB1, 0x9F, 0x6C, 0x9F, 0x6C, 0xFF, 0x9F, 0x6C,
    0x9F, 0x6C, 0x9F, 0x6C, 0x7F, 0x76, 0xF0, 0x1A, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF,
    0x0E, 0xFF, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF, 0x0E, 0xCF,
    0x0E, 0xCF, 0x0E, 0xCE, 0x0E,
  ]
  let raw = FixedArray::make(windows_chunk.length(), Byte::default())
  for i in 0..<windows_chunk.length() {
    raw[i] = (windows_chunk[i] & 0xFF).to_byte()
  }
  let out = @ntfs.decompress(Bytes::from_array(raw), 4096) catch {
    err => {
      println(@ntfs.describe_error(err))
      assert_true(false)
      return
    }
  }
  assert_eq(out.length(), 4096)
  assert_eq(FIXTURE_LINE.length(), 79)
  // 一个块还原 4096 字节 = 51 行多，逐字节对回周期文本
  for i in 0..<4096 {
    if out[i] != FIXTURE_LINE[i % 79] {
      println("first mismatch at " + i.to_string())
      assert_true(false)
      return
    }
  }
}

///|
test "phrase may overlap the bytes it is producing" {
  // 块头 0xB003：低 12 位 = 4 - 1，bit15 = 1（压缩）。
  // 负载：flags=0x02（第 2 个 token 是短语），字面量 'A'，
  // 短语长度 16、距离 1 —— 边写边读，必须逐字节复制。
  let src = Bytes::from_array([0x03, 0xB0, 0x02, 0x41, 0x0D, 0x00])
  let out = @ntfs.decompress(src, 64) catch {
    err => {
      println(@ntfs.describe_error(err))
      assert_true(false)
      return
    }
  }
  assert_eq(out.length(), 17)
  for i in 0..<17 {
    assert_eq(out[i].to_int(), 0x41)
  }
}

///|
test "an uncompressed chunk is copied verbatim" {
  // bit15 = 0：数据原样存放，压缩反而变大的情形走这条分支
  let src = Bytes::from_array([0x03, 0x30, 0x61, 0x62, 0x63, 0x64])
  let out = @ntfs.decompress(src, 64) catch {
    err => {
      println(@ntfs.describe_error(err))
      assert_true(false)
      return
    }
  }
  assert_eq(out.length(), 4)
  assert_eq(out[0].to_int(), 0x61)
  assert_eq(out[3].to_int(), 0x64)
}

///|
test "a phrase reaching before the chunk start is rejected" {
  // 块内还没有任何输出，短语却要回溯 6 字节
  let src = Bytes::from_array([0x03, 0xB0, 0x01, 0x00, 0x50, 0x00])
  let result = Ok(@ntfs.decompress(src, 64)) catch { e => Err(e) }
  assert_true(result is Err(@ntfs.Corrupt(_)))
}

///|
test "a truncated phrase token is rejected" {
  // 声明 3 字节负载，但短语需要 2 字节，只剩 1 字节
  let src = Bytes::from_array([0x02, 0xB0, 0x01, 0x41, 0x0D])
  let result = Ok(@ntfs.decompress(src, 64)) catch { e => Err(e) }
  assert_true(result is Err(@ntfs.Corrupt(_)))
}

///|
test "decompression stops at the declared limit" {
  // 一个块最多 4096 字节；即使输入后面还跟着看起来像块头的字节，
  // 达到上限也必须停，否则会把分配里的填充字节解成垃圾
  let src = Bytes::from_array([
    0x03, 0xB0, 0x02, 0x41, 0x0D, 0x00, 0x03, 0xB0, 0x02, 0x41, 0x0D, 0x00,
  ])
  let out = @ntfs.decompress(src, 17) catch {
    err => {
      println(@ntfs.describe_error(err))
      assert_true(false)
      return
    }
  }
  assert_eq(out.length(), 17)
}
